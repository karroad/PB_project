# ---------------------------------------------------------------
# SiteForge AI — backend configuration
# Copy to .env and adjust. Every value has a safe local default.
# ---------------------------------------------------------------

# Public URL of this API (used to build live URLs of locally hosted sites)
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Database — SQLite by default. For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://siteforge:secret@localhost:5432/siteforge
# DATABASE_URL=sqlite:///./data/siteforge.db

# Security — CHANGE THESE in any shared environment
SECRET_KEY=change-me-to-a-long-random-string
# Optional dedicated Fernet key for provider credentials (otherwise derived from SECRET_KEY)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_EMAIL=admin@siteforge.local
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------
# The platform uses up to three AIs, each for one job:
#   CONTENT (text/brand/plan) -> Claude        (AI_PROVIDER below)
#   CODE    (unique HTML/CSS)  -> z.ai GLM      (CODE_PROVIDER below)
#   IMAGES                     -> Fal.ai        (FAL_KEY below)
# ---------------------------------------------------------------

# AI content provider: auto | anthropic | claude_cli | offline
#   auto        -> Anthropic when ANTHROPIC_API_KEY is set, otherwise the offline generator
#   anthropic   -> metered Anthropic API key (pay per use)
#   claude_cli  -> the MONTHLY Claude subscription via the Claude Code CLI (no API key).
#                  Requires `claude` installed and `claude login` done on THIS machine
#                  (e.g. the production server). Great to avoid metered costs; subject to plan usage limits.
#   offline     -> deterministic built-in generator (no API calls, for demos/tests)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT=240

# Code generation — the AI that writes each site's unique code/design (not a fixed template)
#   CODE_PROVIDER: auto | zai | anthropic | offline
#     auto      -> z.ai when ZAI_API_KEY is set, else the built-in template renderer
#     zai       -> z.ai GLM Coding Plan (Anthropic-compatible endpoint); use the Flash model
#     anthropic -> use the Claude key to write code too (pricier; stopgap if z.ai has no balance)
#     offline   -> built-in template renderer (same-looking sites)
AI_CODE_GENERATION=true
CODE_PROVIDER=auto
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic
ZAI_MODEL=glm-5.3-flash

# Fal.ai image generation (falls back to generated SVG artwork when empty)
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# Orchestration
MAX_CONCURRENT_JOBS=3
AI_MAX_CONCURRENT_REQUESTS=4
STEP_RETRIES=2
# Small delay between log lines in offline mode so the pipeline animation is visible
SIMULATED_STEP_DELAY=0.45

# Scaling — with Redis, run the API with RUN_EMBEDDED_WORKER=false and start N workers:
#   python -m app.worker
REDIS_URL=
RUN_EMBEDDED_WORKER=true
JOB_TIMEOUT_SECONDS=1800
STEP_TIMEOUT_SECONDS=600

# Notifications — optional Slack/Teams/Discord-compatible incoming webhook
NOTIFY_WEBHOOK_URL=

# Monitoring / recovery
RUN_MONITOR=true
MONITOR_INTERVAL_SECONDS=60
STALE_JOB_SECONDS=300
PROVIDER_CONCURRENCY=2
# Public IP of the server that hosts the sites (used for DNS A records). When set, the
# platform also serves locally hosted sites on their own domains (Host-based routing).
SERVER_PUBLIC_IP=

# Automation policy
AUTO_PUBLISH=true                   # sites go online automatically after the quality gate
APPROVAL_DOMAIN_PURCHASE=true       # an admin confirms each paid domain purchase (set false for fully hands-off)
APPROVAL_DNS_CHANGES=false
APPROVAL_PROVISION_HOSTING=true     # paid servers such as Hetzner
DOMAIN_MAX_PRICE=50                 # hard cap per registration in the provider's currency; 0 disables buying
DOMAIN_REGISTRATION_YEARS=1
DOMAIN_AUTO_RENEW=true
DOMAIN_ACTIVATION_TIMEOUT_SECONDS=420
# Simulate Cloudflare/OVH for demos and testing: no real API calls, nothing is charged
SANDBOX_PROVIDERS=false

# Docker hosting adapter (requires Docker + docker compose on this machine)
DOCKER_ENABLED=false
# Actually run `npm install && npm run build` for generated Next.js projects
BUILD_NEXTJS=false
